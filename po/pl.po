#: usr/share/fedorajam-audio-config/backend/audio_config.py:36
msgid "Don't restrict self connect requests (default)"
msgstr "Nie ograniczaj żądań samopołączenia (domyślnie)"

#: usr/share/fedorajam-audio-config/backend/audio_config.py:37
msgid "Fail self connect requests to external ports only"
msgstr "Odrzucaj żądania samopołączenia tylko do portów zewnętrznych"

#: usr/share/fedorajam-audio-config/backend/audio_config.py:38
msgid "Ignore self connect requests to external ports only"
msgstr "Ignoruj żądania samopołączenia tylko do portów zewnętrznych"

#: usr/share/fedorajam-audio-config/backend/audio_config.py:39
msgid "Fail all self connect requests"
msgstr "Odrzucaj wszystkie żądania samopołączenia"

#: usr/share/fedorajam-audio-config/backend/audio_config.py:40
msgid "Ignore all self connect requests"
msgstr "Ignoruj wszystkie żądania samopołączenia"

#: usr/share/fedorajam-audio-config/backend/audio_config.py:44
msgid "Show the Monitor client and its ports."
msgstr "Pokaż klienta Monitor i jego porty."

#: usr/share/fedorajam-audio-config/backend/audio_config.py:46
msgid ""
"Exposes the capture ports and monitor ports on the same JACK device client."
msgstr ""
"Udostępnia porty przechwytywania i porty monitora na tym samym kliencie "
"urządzenia JACK."

#: usr/share/fedorajam-audio-config/backend/audio_config.py:48
msgid "Show the MIDI clients and their ports."
msgstr "Pokaż klientów MIDI i ich porty."

#: usr/share/fedorajam-audio-config/backend/audio_config.py:49
msgid "Use shorter names for the device client name."
msgstr "Używaj krótszych nazw dla nazwy klienta urządzenia."

#: usr/share/fedorajam-audio-config/backend/audio_config.py:54
#: usr/share/fedorajam-audio-config/ui/qt_ui.py:119
msgid "Fedora Jam Audio Configuration"
msgstr "Konfiguracja dźwięku Fedora Jam"

#: usr/share/fedorajam-audio-config/backend/audio_config.py:113
msgid "Makes the kernel fully-preemptible, best for lowlatency workloads"
msgstr ""
"Czyni jądro w pełni wywłaszczalnym, najlepsze dla obciążeń o niskim "
"opóźnieniu"

#: usr/share/fedorajam-audio-config/backend/audio_config.py:116
msgid ""
"Forces interrupt handlers to run in a threaded context, reducing buffer xruns"
msgstr ""
"Wymusza uruchamianie procedur obsługi przerwań w kontekście wątkowym, "
"redukując przepełnienia bufora"

#: usr/share/fedorajam-audio-config/backend/audio_config.py:120
msgid ""
"Offloads Read-Copy-Update (RCU) callbacks from all CPUs to dedicated kernel "
"threads, improves real-time performance."
msgstr ""
"Przenosi wywołania zwrotne Read-Copy-Update (RCU) ze wszystkich procesorów "
"na dedykowane wątki jądra, poprawia wydajność czasu rzeczywistego."

#: usr/share/fedorajam-audio-config/backend/audio_config.py:124
msgid "Reduces noise in latency critical applications such as virtualization"
msgstr "Redukuje szum w aplikacjach krytycznych pod względem opóźnień, takich jak wirtualizacja"

#: usr/share/fedorajam-audio-config/main.py:89
msgid ""
"ERROR: Neither GTK 4 (python3-gi + gir1.2-adw-1) nor PyQt6 (python3-pyqt6) "
"is available."
msgstr ""
"BŁĄD: Ani GTK 4 (python3-gi + gir1.2-adw-1), ani PyQt6 (python3-pyqt6) "
"nie jest dostępne."

#: usr/share/fedorajam-audio-config/main.py:111
msgid ""
"You have the PipeWire Settings Plasma Widget installed.\n"
"Use that to change the PipeWire Quantum & Sample Rate.\n"
"(This is recommended if you are using KDE Plasma Desktop)\n"
"You can find it in your system tray or add it to your panel."
msgstr ""
"Masz zainstalowany widget Plasma ustawień PipeWire.\n"
"Użyj go, aby zmienić Quantum i częstotliwość próbkowania PipeWire.\n"
"(Jest to zalecane, jeśli używasz pulpitu KDE Plasma)\n"
"Znajdziesz go w zasobniku systemowym lub możesz dodać go do panelu."

#: usr/share/fedorajam-audio-config/main.py:120
msgid ""
"You have the PipeWire Settings GNOME Shell Extension installed.\n"
"Use that to change the PipeWire Quantum & Sample Rate.\n"
"(This is recommended if you are using GNOME Shell)\n"
"You can find it in Extension Manager if it's not already\n"
"on your panel."
msgstr ""
"Masz zainstalowane rozszerzenie GNOME Shell ustawień PipeWire.\n"
"Użyj go, aby zmienić Quantum i częstotliwość próbkowania PipeWire.\n"
"(Jest to zalecane, jeśli używasz GNOME Shell)\n"
"Znajdziesz je w Extension Manager, jeśli nie ma go jeszcze\n"
"na Twoim panelu."

#: usr/share/fedorajam-audio-config/main.py:137
msgid ""
"Select the Buffer Size and Sample Rate for PipeWire\n"
"Quantum configuration.\n"
"\n"
"If you're not sure what to do here, it's best to leave\n"
"the current settings in place.\n"
"\n"
"Note: Defaults are controlled via the\n"
"fedorajam-pwjack-config terminal command"
msgstr ""
"Wybierz rozmiar bufora i częstotliwość próbkowania dla konfiguracji\n"
"PipeWire Quantum.\n"
"\n"
"Jeśli nie wiesz, co tu zrobić, najlepiej pozostaw\n"
"bieżące ustawienia bez zmian.\n"
"\n"
"Uwaga: Wartości domyślne są kontrolowane za pomocą polecenia\n"
"terminala fedorajam-pwjack-config"

#: usr/share/fedorajam-audio-config/main.py:145
msgid "Buffer Size"
msgstr "Rozmiar bufora"

#: usr/share/fedorajam-audio-config/main.py:150
msgid "Sample Rate (Hz)"
msgstr "Częstotliwość próbkowania (Hz)"

#: usr/share/fedorajam-audio-config/main.py:155
#: usr/share/fedorajam-audio-config/main.py:180
msgid "Next"
msgstr "Dalej"

#: usr/share/fedorajam-audio-config/main.py:156
#: usr/share/fedorajam-audio-config/main.py:181
#: usr/share/fedorajam-audio-config/main.py:205
msgid "Cancel"
msgstr "Anuluj"

#: usr/share/fedorajam-audio-config/main.py:178
msgid "Select which JACK plugin options you would like"
msgstr "Wybierz żądane opcje wtyczki JACK"

#: usr/share/fedorajam-audio-config/main.py:201
msgid ""
"Select the self-connect mode. If you don't know what this is, leave it alone."
msgstr ""
"Wybierz tryb samopołączenia. Jeśli nie wiesz, co to jest, pozostaw bez zmian."

#: usr/share/fedorajam-audio-config/main.py:204
msgid "Apply"
msgstr "Zastosuj"

#: usr/share/fedorajam-audio-config/main.py:233
msgid ""
"JACK configuration applied.\n"
"\n"
"Buffer and Sample Rate are managed by your\n"
"desktop widget / extension."
msgstr ""
"Konfiguracja JACK została zastosowana.\n"
"\n"
"Rozmiar bufora i częstotliwość próbkowania są zarządzane\n"
"przez widget pulpitu / rozszerzenie."

#: usr/share/fedorajam-audio-config/main.py:240
#, python-brace-format
msgid ""
"Configuration applied.\n"
"\n"
"Buffer Size: {buf}\n"
"Sample Rate: {rate} Hz"
msgstr ""
"Konfiguracja została zastosowana.\n"
"\n"
"Rozmiar bufora: {buf}\n"
"Częstotliwość próbkowania: {rate} Hz"

#: usr/share/fedorajam-audio-config/main.py:279
msgid ""
"Select which kernel boot parameters you would like. Default is first three."
msgstr ""
"Wybierz żądane parametry rozruchu jądra. Domyślne to trzy pierwsze."

#: usr/share/fedorajam-audio-config/main.py:282
msgid "Apply (Password Required)"
msgstr "Zastosuj (wymagane hasło)"

#: usr/share/fedorajam-audio-config/main.py:283
msgid "Back"
msgstr "Wstecz"

#: usr/share/fedorajam-audio-config/main.py:297
msgid "Applying boot parameters…"
msgstr "Stosowanie parametrów rozruchu…"

#: usr/share/fedorajam-audio-config/main.py:303
msgid "You must restart your computer for these changes to take effect."
msgstr "Musisz ponownie uruchomić komputer, aby zmiany zostały zastosowane."

#: usr/share/fedorajam-audio-config/main.py:309
msgid "An error has occurred or action was cancelled."
msgstr "Wystąpił błąd lub akcja została anulowana."

#: usr/share/fedorajam-audio-config/main.py:319
msgid ""
"Sometimes, you may wish to enable a dummy audio device for your system audio "
"or an audio application so that you don't inadvertently feed that to your "
"main output or draw from your main input. This can be useful when you wish "
"to send a music application to your DAW or other mixer without sending to "
"your main system output. There may be other workflow reasons as well.\n"
"\n"
"Do you wish to start a stereo dummy audio device?"
msgstr ""
"Czasami możesz chcieć włączyć wirtualne urządzenie dźwiękowe dla dźwięku "
"systemowego lub aplikacji dźwiękowej, aby przypadkowo nie przesłać go do "
"głównego wyjścia lub nie pobierać z głównego wejścia. Może to być przydatne, "
"gdy chcesz wysłać aplikację muzyczną do DAW lub innego miksera bez wysyłania "
"do głównego wyjścia systemowego. Mogą istnieć również inne powody związane z "
"przepływem pracy.\n"
"\n"
"Czy chcesz uruchomić stereofoniczne wirtualne urządzenie dźwiękowe?"

#: usr/share/fedorajam-audio-config/main.py:329
msgid "Yes"
msgstr "Tak"

#: usr/share/fedorajam-audio-config/main.py:330
msgid "Go Back"
msgstr "Cofnij się"

#: usr/share/fedorajam-audio-config/main.py:335
#: usr/share/fedorajam-audio-config/main.py:349
msgid "Would you like the dummy audio device to start at login?"
msgstr "Czy chcesz, aby wirtualne urządzenie dźwiękowe uruchamiało się przy logowaniu?"

#: usr/share/fedorajam-audio-config/main.py:344
msgid "Would you like to stop the dummy audio device?"
msgstr "Czy chcesz zatrzymać wirtualne urządzenie dźwiękowe?"

#: usr/share/fedorajam-audio-config/main.py:368
msgid "STOP Dummy Audio Device"
msgstr "ZATRZYMAJ wirtualne urządzenie dźwiękowe"

#: usr/share/fedorajam-audio-config/main.py:369
msgid "START Dummy Audio Device"
msgstr "URUCHOM wirtualne urządzenie dźwiękowe"

#: usr/share/fedorajam-audio-config/main.py:375
msgid "Configure Current Audio Configuration"
msgstr "Konfiguruj bieżącą konfigurację dźwięku"

#: usr/share/fedorajam-audio-config/main.py:380
msgid "Change Kernel Boot Parameters"
msgstr "Zmień parametry rozruchu jądra"

#: usr/share/fedorajam-audio-config/main.py:392
msgid "What would you like to do?"
msgstr "Co chcesz zrobić?"

#: usr/share/fedorajam-audio-config/main.py:394
msgid "Continue"
msgstr "Kontynuuj"

#: usr/share/fedorajam-audio-config/main.py:395
msgid "Close"
msgstr "Zamknij"

#: usr/share/fedorajam-audio-config/ui/gtk_ui.py:80
msgid "OK"
msgstr "OK"
