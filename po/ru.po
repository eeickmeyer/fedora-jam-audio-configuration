#: ../usr/share/fedorajam-audio-config/backend/audio_config.py:36
msgid "Don't restrict self connect requests (default)"
msgstr "Не ограничивать запросы на самоподключение (по умолчанию)"

#: ../usr/share/fedorajam-audio-config/backend/audio_config.py:37
msgid "Fail self connect requests to external ports only"
msgstr "Отклонять запросы на самоподключение только к внешним портам"

#: ../usr/share/fedorajam-audio-config/backend/audio_config.py:38
msgid "Ignore self connect requests to external ports only"
msgstr "Игнорировать запросы на самоподключение только к внешним портам"

#: ../usr/share/fedorajam-audio-config/backend/audio_config.py:39
msgid "Fail all self connect requests"
msgstr "Отклонять все запросы на самоподключение"

#: ../usr/share/fedorajam-audio-config/backend/audio_config.py:40
msgid "Ignore all self connect requests"
msgstr "Игнорировать все запросы на самоподключение"

#: ../usr/share/fedorajam-audio-config/backend/audio_config.py:44
msgid "Show the Monitor client and its ports."
msgstr "Показать клиент Monitor и его порты."

#: ../usr/share/fedorajam-audio-config/backend/audio_config.py:46
msgid ""
"Exposes the capture ports and monitor ports on the same JACK device client."
msgstr ""
"Объединяет порты захвата и мониторинга на одном клиенте устройства JACK."

#: ../usr/share/fedorajam-audio-config/backend/audio_config.py:48
msgid "Show the MIDI clients and their ports."
msgstr "Показать клиенты MIDI и их порты."

#: ../usr/share/fedorajam-audio-config/backend/audio_config.py:49
msgid "Use shorter names for the device client name."
msgstr "Использовать сокращённые имена для клиента устройства."

#: ../usr/share/fedorajam-audio-config/backend/audio_config.py:54
#: ../usr/share/fedorajam-audio-config/ui/qt_ui.py:120
msgid "Fedora Jam Audio Configuration"
msgstr "Fedora Jam Audio Configuration"

#: ../usr/share/fedorajam-audio-config/backend/audio_config.py:113
msgid "Makes the kernel fully-preemptible, best for lowlatency workloads"
msgstr ""
"Делает ядро полностью вытесняемым, оптимально для задач с низкой задержкой"

#: ../usr/share/fedorajam-audio-config/backend/audio_config.py:116
msgid ""
"Forces interrupt handlers to run in a threaded context, reducing buffer "
"xruns"
msgstr ""
"Принудительно запускает обработчики прерываний в потоковом контексте, "
"уменьшая пропуски буфера"

#: ../usr/share/fedorajam-audio-config/backend/audio_config.py:120
msgid ""
"Offloads Read-Copy-Update (RCU) callbacks from all CPUs to dedicated kernel "
"threads, improves real-time performance."
msgstr ""
"Переносит обратные вызовы Read-Copy-Update (RCU) со всех процессоров на "
"выделенные потоки ядра, улучшает производительность в реальном времени."

#: ../usr/share/fedorajam-audio-config/backend/audio_config.py:124
msgid "Reduces noise in latency critical applications such as virtualization"
msgstr ""
"Снижает шумы в критичных к задержке приложениях, таких как виртуализация"

#: ../usr/share/fedorajam-audio-config/ui/gtk_ui.py:81
msgid "OK"
msgstr "OK"

#: ../usr/share/fedorajam-audio-config/main.py:111
msgid ""
"ERROR: Neither GTK 4 (python3-gi + gir1.2-adw-1) nor PyQt6 (python3-pyqt6) "
"is available."
msgstr ""
"ОШИБКА: Ни GTK 4 (python3-gi + gir1.2-adw-1), ни PyQt6 (python3-pyqt6) не "
"доступны."

#: ../usr/share/fedorajam-audio-config/main.py:133
msgid ""
"You have the PipeWire Settings Plasma Widget installed.\n"
"Use that to change the PipeWire Quantum & Sample Rate.\n"
"(This is recommended if you are using KDE Plasma Desktop)\n"
"You can find it in your system tray or add it to your panel."
msgstr ""
"У вас установлен виджет PipeWire Settings для Plasma.\n"
"Используйте его для изменения Quantum и частоты дискретизации PipeWire.\n"
"(Рекомендуется при использовании рабочего стола KDE Plasma)\n"
"Вы можете найти его в системном лотке или добавить на панель."

#: ../usr/share/fedorajam-audio-config/main.py:142
msgid ""
"You have the PipeWire Settings GNOME Shell Extension installed.\n"
"Use that to change the PipeWire Quantum & Sample Rate.\n"
"(This is recommended if you are using GNOME Shell)\n"
"You can find it in Extension Manager if it's not already\n"
"on your panel."
msgstr ""
"У вас установлено расширение PipeWire Settings для GNOME Shell.\n"
"Используйте его для изменения Quantum и частоты дискретизации PipeWire.\n"
"(Рекомендуется при использовании GNOME Shell)\n"
"Вы можете найти его в Extension Manager, если оно ещё\n"
"не добавлено на панель."

#: ../usr/share/fedorajam-audio-config/main.py:159
msgid ""
"Select the Buffer Size and Sample Rate for PipeWire\n"
"Quantum configuration.\n"
"\n"
"If you're not sure what to do here, it's best to leave\n"
"the current settings in place.\n"
"\n"
"Note: Defaults are controlled via the\n"
"fedorajam-pwjack-config terminal command"
msgstr ""
"Выберите размер буфера и частоту дискретизации для\n"
"конфигурации PipeWire Quantum.\n"
"\n"
"Если вы не уверены, что здесь делать, лучше оставить\n"
"текущие настройки без изменений.\n"
"\n"
"Примечание: значения по умолчанию управляются через\n"
"терминальную команду fedorajam-pwjack-config"

#: ../usr/share/fedorajam-audio-config/main.py:167
#: ../usr/share/fedorajam-audio-config/main.py:467
msgid "Buffer Size"
msgstr "Размер буфера"

#: ../usr/share/fedorajam-audio-config/main.py:172
#: ../usr/share/fedorajam-audio-config/main.py:472
msgid "Sample Rate (Hz)"
msgstr "Частота дискретизации (Гц)"

#: ../usr/share/fedorajam-audio-config/main.py:177
#: ../usr/share/fedorajam-audio-config/main.py:202
#: ../usr/share/fedorajam-audio-config/main.py:453
msgid "Next"
msgstr "Далее"

#: ../usr/share/fedorajam-audio-config/main.py:178
#: ../usr/share/fedorajam-audio-config/main.py:203
#: ../usr/share/fedorajam-audio-config/main.py:227
#: ../usr/share/fedorajam-audio-config/main.py:409
#: ../usr/share/fedorajam-audio-config/main.py:454
#: ../usr/share/fedorajam-audio-config/main.py:478
msgid "Cancel"
msgstr "Отмена"

#: ../usr/share/fedorajam-audio-config/main.py:200
msgid "Select which JACK plugin options you would like"
msgstr "Выберите нужные параметры плагина JACK"

#: ../usr/share/fedorajam-audio-config/main.py:223
msgid ""
"Select the self-connect mode. If you don't know what this is, leave it "
"alone."
msgstr ""
"Выберите режим самоподключения. Если вы не знаете, что это, оставьте без "
"изменений."

#: ../usr/share/fedorajam-audio-config/main.py:226
#: ../usr/share/fedorajam-audio-config/main.py:477
msgid "Apply"
msgstr "Применить"

#: ../usr/share/fedorajam-audio-config/main.py:255
msgid ""
"JACK configuration applied.\n"
"\n"
"Buffer and Sample Rate are managed by your\n"
"desktop widget / extension."
msgstr ""
"Конфигурация JACK применена.\n"
"\n"
"Размер буфера и частота дискретизации управляются\n"
"вашим виджетом рабочего стола / расширением."

#: ../usr/share/fedorajam-audio-config/main.py:262
#, python-brace-format
msgid ""
"Configuration applied.\n"
"\n"
"Buffer Size: {buf}\n"
"Sample Rate: {rate} Hz"
msgstr ""
"Конфигурация применена.\n"
"\n"
"Размер буфера: {buf}\n"
"Частота дискретизации: {rate} Гц"

#: ../usr/share/fedorajam-audio-config/main.py:301
msgid ""
"Select which kernel boot parameters you would like. Default is first three."
msgstr ""
"Выберите нужные параметры загрузки ядра. По умолчанию выбраны первые три."

#: ../usr/share/fedorajam-audio-config/main.py:304
msgid "Apply (Password Required)"
msgstr "Применить (требуется пароль)"

#: ../usr/share/fedorajam-audio-config/main.py:305
msgid "Back"
msgstr "Назад"

#: ../usr/share/fedorajam-audio-config/main.py:319
msgid "Applying boot parameters…"
msgstr "Применение параметров загрузки…"

#: ../usr/share/fedorajam-audio-config/main.py:325
msgid "You must restart your computer for these changes to take effect."
msgstr "Необходимо перезагрузить компьютер, чтобы изменения вступили в силу."

#: ../usr/share/fedorajam-audio-config/main.py:331
msgid "An error has occurred or action was cancelled."
msgstr "Произошла ошибка или действие было отменено."

#: ../usr/share/fedorajam-audio-config/main.py:341
msgid ""
"Sometimes, you may wish to enable a dummy audio device for your system audio or an audio application so that you don't inadvertently feed that to your main output or draw from your main input. This can be useful when you wish to send a music application to your DAW or other mixer without sending to your main system output. There may be other workflow reasons as well.\n"
"\n"
"Do you wish to start a stereo dummy audio device?"
msgstr ""
"Иногда может потребоваться включить фиктивное аудиоустройство для системного звука или аудиоприложения, чтобы случайно не направить звук на основной выход или не захватить сигнал с основного входа. Это может быть полезно, если вы хотите направить музыкальное приложение в DAW или другой микшер, не отправляя звук на основной системный выход. Могут быть и другие причины, связанные с рабочим процессом.\n"
"\n"
"Хотите запустить стерео фиктивное аудиоустройство?"

#: ../usr/share/fedorajam-audio-config/main.py:351
msgid "Yes"
msgstr "Да"

#: ../usr/share/fedorajam-audio-config/main.py:352
msgid "Go Back"
msgstr "Вернуться"

#: ../usr/share/fedorajam-audio-config/main.py:357
#: ../usr/share/fedorajam-audio-config/main.py:371
msgid "Would you like the dummy audio device to start at login?"
msgstr "Запускать фиктивное аудиоустройство при входе в систему?"

#: ../usr/share/fedorajam-audio-config/main.py:366
msgid "Would you like to stop the dummy audio device?"
msgstr "Хотите остановить фиктивное аудиоустройство?"

#: ../usr/share/fedorajam-audio-config/main.py:386
msgid ""
"A FireWire (FFADO) PipeWire configuration already exists.\n"
"\n"
"Would you like to reconfigure it?\n"
"(Choose 'No' to remove the existing configuration)"
msgstr ""
"Конфигурация FireWire (FFADO) для PipeWire уже существует.\n"
"\n"
"Вы хотите перенастроить её?\n"
"(Выберите «Нет», чтобы удалить существующую конфигурацию)"

#: ../usr/share/fedorajam-audio-config/main.py:389
msgid "Reconfigure"
msgstr "Перенастроить"

#: ../usr/share/fedorajam-audio-config/main.py:390
msgid "Remove"
msgstr "Удалить"

#: ../usr/share/fedorajam-audio-config/main.py:396
msgid ""
"FireWire (FFADO) PipeWire configuration removed.\n"
"PipeWire has been restarted."
msgstr ""
"Конфигурация FireWire (FFADO) для PipeWire удалена.\n"
"PipeWire перезапущен."

#: ../usr/share/fedorajam-audio-config/main.py:405
msgid ""
"FireWire (FFADO) audio support requires the 'ffado' package to be installed.\n"
"\n"
"Would you like to install it now?"
msgstr ""
"Для поддержки аудио FireWire (FFADO) требуется установка пакета «ffado».\n"
"\n"
"Установить сейчас?"

#: ../usr/share/fedorajam-audio-config/main.py:408
msgid "Install"
msgstr "Установить"

#: ../usr/share/fedorajam-audio-config/main.py:415
msgid "Installing ffado…"
msgstr "Установка ffado…"

#: ../usr/share/fedorajam-audio-config/main.py:421
msgid "Failed to install ffado."
msgstr "Не удалось установить ffado."

#: ../usr/share/fedorajam-audio-config/main.py:429
msgid ""
"No FireWire audio devices were detected.\n"
"\n"
"Make sure your FireWire device is connected and powered on, and that the firewire_ohci and firewire_core kernel modules are loaded."
msgstr ""
"Аудиоустройства FireWire не обнаружены.\n"
"\n"
"Убедитесь, что устройство FireWire подключено и включено, а модули ядра firewire_ohci и firewire_core загружены."

#: ../usr/share/fedorajam-audio-config/main.py:444
#, python-brace-format
msgid "GUID: {guid}"
msgstr "GUID: {guid}"

#: ../usr/share/fedorajam-audio-config/main.py:451
msgid "Select the FireWire audio device to use with PipeWire:"
msgstr "Выберите аудиоустройство FireWire для использования с PipeWire:"

#: ../usr/share/fedorajam-audio-config/main.py:463
msgid ""
"Select the Buffer Size and Sample Rate for the FireWire device.\n"
"\n"
"Note: Many FireWire devices require a buffer size of 256 or larger."
msgstr ""
"Выберите размер буфера и частоту дискретизации для устройства FireWire.\n"
"\n"
"Примечание: Многие устройства FireWire требуют размер буфера 256 или больше."

#: ../usr/share/fedorajam-audio-config/main.py:489
#, python-brace-format
msgid ""
"FireWire audio configured.\n"
"\n"
"Device:      {device}\n"
"Buffer Size: {buf}\n"
"Sample Rate: {rate} Hz\n"
"\n"
"PipeWire has been restarted."
msgstr ""
"Аудио FireWire настроено.\n"
"\n"
"Устройство:      {device}\n"
"Размер буфера: {buf}\n"
"Частота дискретизации: {rate} Гц\n"
"\n"
"PipeWire перезапущен."

#: ../usr/share/fedorajam-audio-config/main.py:512
msgid "STOP Dummy Audio Device"
msgstr "ОСТАНОВИТЬ фиктивное аудиоустройство"

#: ../usr/share/fedorajam-audio-config/main.py:513
msgid "START Dummy Audio Device"
msgstr "ЗАПУСТИТЬ фиктивное аудиоустройство"

#: ../usr/share/fedorajam-audio-config/main.py:518
msgid "Reconfigure / Remove FireWire (FFADO) Audio Device"
msgstr "Перенастроить / Удалить аудиоустройство FireWire (FFADO)"

#: ../usr/share/fedorajam-audio-config/main.py:520
msgid "Configure FireWire (FFADO) Audio Device"
msgstr "Настроить аудиоустройство FireWire (FFADO)"

#: ../usr/share/fedorajam-audio-config/main.py:526
msgid "Configure Current Audio Configuration"
msgstr "Настроить текущую конфигурацию звука"

#: ../usr/share/fedorajam-audio-config/main.py:531
msgid "Change Kernel Boot Parameters"
msgstr "Изменить параметры загрузки ядра"

#: ../usr/share/fedorajam-audio-config/main.py:552
msgid "What would you like to do?"
msgstr "Что вы хотите сделать?"

#: ../usr/share/fedorajam-audio-config/main.py:554
msgid "Continue"
msgstr "Продолжить"

#: ../usr/share/fedorajam-audio-config/main.py:555
msgid "Close"
msgstr "Закрыть"
